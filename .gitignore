# --- secrets: NEVER commit ---
.env
.env.*
!.env.example

# --- python ---
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
# The upload pipeline writes real derivative files during tests; the fixture
# points storage here so a run never touches the developer's own catalogue.
backend/.pytest-tmp/

# --- node / next ---
node_modules/
.next/
out/
*.tsbuildinfo
npm-debug.log*

# --- heavy data: stays OUT of git (object storage instead) ---
data/
assets/
# The catalogue photographs as they came out of the image model, one folder per
# carpet. `dataset/` is the *reviewable* half of the catalogue — profiles.json,
# prompts.md and chat-guide.md, all of them text somebody can argue with — and
# these forty folders are 339 MB of pixels that would drown it. They are not a
# separate asset either: `ingest_catalog.py` copies them into `data/catalog-gen`
# and from there into storage, which is the same road every other product's
# photographs travel. Keep a copy off the machine; git is not that copy.
dataset/[0-9][0-9]_*/
docs/prototypes/**/frames/
# The intro's frame sets — hundreds of files and tens of megabytes, rebuilt
# from the film in `assets/` by `backend/scripts/extract_intro_frames.py`.
# Derived, reproducible, and far too heavy for git; deployment ships them as
# static files like any other asset.
frontend/public/intro/
*.glb
*.usdz
models/weights/

# exception: the spike's AR fixtures are served by GitHub Pages for phone testing
!spike/assets/*.glb
!spike/assets/*.usdz

# --- local tooling ---
.DS_Store
Thumbs.db

# Generated catalogue images, dropped in by hand. Heavy and reproducible.
dataset/f*/
dataset/_check.png

# --- phase 5 ---
# Playwright's own output: a report, a trace zip and a video per failure. Useful
# for the twenty minutes after a red run and worthless afterwards.
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/.playwright/
# Evaluation output — contact sheets, raw rank dumps, rendered scenes. All of it
# is regenerated by `backend/scripts/eval_*.py` in minutes, and none of it is
# the *source* of a number: the numbers that matter are quoted in ROADMAP and
# recomputed by the notebooks.
data/eval/
