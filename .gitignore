# --- secrets: NEVER commit ---
.env
.env.*
!.env.example

# --- python ---
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
# The upload pipeline writes real derivative files during tests; the fixture
# points storage here so a run never touches the developer's own catalogue.
backend/.pytest-tmp/

# --- node / next ---
node_modules/
.next/
out/
*.tsbuildinfo
npm-debug.log*

# --- heavy data: stays OUT of git (object storage instead) ---
data/
assets/
docs/prototypes/**/frames/
# The intro's frame sets — hundreds of files and tens of megabytes, rebuilt
# from the film in `assets/` by `backend/scripts/extract_intro_frames.py`.
# Derived, reproducible, and far too heavy for git; deployment ships them as
# static files like any other asset.
frontend/public/intro/
*.glb
*.usdz
models/weights/

# exception: the spike's AR fixtures are served by GitHub Pages for phone testing
!spike/assets/*.glb
!spike/assets/*.usdz

# --- local tooling ---
.DS_Store
Thumbs.db

# Generated catalogue images, dropped in by hand. Heavy and reproducible.
dataset/f*/
dataset/_check.png
