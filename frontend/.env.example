# Where this server reaches the backend.
#
# The browser never uses it: `/api` and `/files` are proxied by next.config.ts
# so the page only ever addresses its own origin, which is what lets the site
# be opened from a phone on the same network and what production looks like
# behind Caddy. This is the address the Next server itself dials, and it is
# also what the proxy forwards to.
API_INTERNAL_URL=http://localhost:8000
