# Copy to infra/.env and fill in. Never commit the filled-in copy.
#
# The API refuses to start if SESSION_SECRET is still the development default or
# ADMIN_PASSWORD_HASH is empty (app/core/config.py). That refusal is the point:
# both failures are otherwise silent — a shop that serves every page correctly
# while its sessions are forgeable, or an admin panel nobody can reach.

# --- the host -----------------------------------------------------------
# Must already resolve to this server. Caddy asks Let's Encrypt for a
# certificate on first start and the challenge fails if DNS is not in place.
SITE_DOMAIN=example.ir
ACME_EMAIL=you@example.com

# --- database -----------------------------------------------------------
# Reachable only on the compose network; still generate a real password —
# `docker compose exec` and any other container on the network can reach it.
POSTGRES_USER=farsh
POSTGRES_PASSWORD=
POSTGRES_DB=farsh

# --- application secrets ------------------------------------------------
# Signs the admin session cookie. Anything unguessable and long:
#   openssl rand -hex 32
SESSION_SECRET=

ADMIN_USERNAME=admin
# bcrypt hash, NOT the password:
#   cd backend && uv run python scripts/hash_password.py
ADMIN_PASSWORD_HASH=

# --- conversational search (optional) -----------------------------------
# Leave empty and /ask runs on the rule-based parser, which needs no network
# and no key. Setting both upgrades the translation; nothing else changes, and
# a dead endpoint falls back to the rules rather than erroring.
LLM_BASE_URL=
LLM_API_KEY=
