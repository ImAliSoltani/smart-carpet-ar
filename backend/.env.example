# Copy to .env and fill in real values. NEVER commit .env.
DATABASE_URL=postgresql+asyncpg://farsh:farsh@localhost:5432/farsh
CORS_ORIGINS=http://localhost:3000
DEBUG=false

# Admin panel — generate the hash with: uv run python scripts/hash_password.py "password"
# An empty hash disables admin login entirely.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Any long random string; rotating it invalidates all admin sessions
SESSION_SECRET=
# Leave unset in production: the session cookie then follows DEBUG and carries
# `Secure`. Set it to false only to sign in over plain http while testing on a
# LAN address — a browser silently drops a `Secure` cookie sent over http, so
# the login appears to do nothing at all.
# SESSION_COOKIE_SECURE=false

# Conversational search (§6-8). Leave these empty and the shop uses its own
# rule-based parser: no key, no network, no cost, and it handles the ordinary
# phrasings. Filling them in upgrades the translation — the model's output is
# validated against the same schema either way, and any failure (dead endpoint,
# expired key, prose instead of JSON) falls back to the parser rather than to an
# error. That is deliberate: the demo must not depend on somebody else's uptime.
#
# The base URL is the provider's OpenAI-compatible root, no trailing path:
#   DeepSeek    https://api.deepseek.com/v1     LLM_MODEL=deepseek-chat
#   OpenRouter  https://openrouter.ai/api/v1    LLM_MODEL=<vendor>/<model>
#   local       http://127.0.0.1:8080/v1        whatever the server calls it
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Files (defaults are fine for development)
STORAGE_DIR=data/storage
STORAGE_PUBLIC_BASE=/files
MAX_UPLOAD_MB=25
